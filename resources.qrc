<RCC>
    <qresource prefix="/qml">
        <file alias="main.qml">src/ui/qml/main.qml</file>
        <file alias="HomePage.qml">src/ui/qml/HomePage.qml</file>
        <file alias="FridgePage.qml">src/ui/qml/FridgePage.qml</file>
        <file alias="RecipesPage.qml">src/ui/qml/RecipesPage.qml</file>
        <file alias="ProfilePage.qml">src/ui/qml/ProfilePage.qml</file>
        <file alias="styles/Theme.qml">src/ui/styles/Theme.qml</file>
        <file alias="Icon.qml">src/ui/components/Icon.qml</file>
        <file alias="RegisterPage.qml">src/ui/qml/RegisterPage.qml</file>
        <file alias="RegisterWindow.qml">src/ui/qml/RegisterWindow.qml</file>
        <file alias="BodyDataCard.qml">src/ui/components/BodyDataCard.qml</file>
        <file alias="GenderButton.qml">src/ui/components/GenderButton.qml</file>
        <file alias="GoalCard.qml">src/ui/components/GoalCard.qml</file>
    </qresource>
    <qresource prefix="/schema">
        <file alias="sqlite_schema.sql">resources/schema/sqlite_schema.sql</file>
    </qresource>
    <qresource prefix="/fonts">
        <file alias="MaterialIconsOutlined.otf">resources/fonts/MaterialIconsOutlined.otf</file>
    </qresource>
</RCC>
